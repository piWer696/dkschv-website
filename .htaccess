# ==============================================================================
# DKSchV Schweiz · Apache Web Server Configuration (Infomaniak Hosting)
# Gehärtete Sicherheitskonfiguration (Schweizer nDSG & KMU Cyber-Resilienz)
# ==============================================================================

# 1. Directory Indexing & Server Signatur deaktivieren
Options -Indexes -ExecCGI
ServerSignature Off

# 2. Enforce UTF-8
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .xml

# 3. URL-Rewriting & Direktsperren fuer sensible Pfade
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Punkt-Dateien und versteckte Ordner sperren (ausser .well-known)
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^\.|/\.) - [F,L]

  # Interne Ordner und Skripte sperren
  RewriteRule ^content(/.*)?$ - [F,L]
  RewriteRule ^scripts(/.*)?$ - [F,L]
  RewriteRule ^shop/tools(/.*)?$ - [F,L]

  # Bezahlvorlagen schuetzen: Direkter Abruf gesperrt, ausser fuer Kunden auf der Danke-Seite
  RewriteCond %{HTTP_REFERER} !dkschv\.ch/shop/danke\.html [NC]
  RewriteRule ^shop/templates(/.*)?$ - [F,L]

  RewriteCond %{HTTP_REFERER} !dkschv\.ch/shop/danke\.html [NC]
  RewriteRule ^shop/templates_printable(/.*)?$ - [F,L]

  RewriteCond %{HTTP_REFERER} !dkschv\.ch/shop/danke\.html [NC]
  RewriteRule ^templates(/.*)?$ - [F,L]

  RewriteCond %{HTTP_REFERER} !dkschv\.ch/shop/danke\.html [NC]
  RewriteRule ^templates_printable(/.*)?$ - [F,L]

  # Saubere URLs (.html Endung im Browser entfernen)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
  RewriteRule ^ %1 [R=301,L]

  # Saubere URLs intern auf .html abbilden falls vorhanden
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# 4. Zugriffsschutz fuer sensible Dateitypen & Credentials
<FilesMatch "(?i)\.(env.*|secret|config|json|lock|md|sh|py|sql|db|sqlite|sqlite3|bak|swp|dist|git.*|zip|tar|gz|7z)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Oeffentliche Entdeckungs-Dateien und Manifeste explizit erlauben
<FilesMatch "^(robots\.txt|sitemap\.xml|llms\.txt|llms-full\.txt|version\.json)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</FilesMatch>

# 5. Maximale Sicherheits-Header
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(self 'https://js.stripe.com')"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://admin.dkschv.ch https://api.stripe.com https://api.open-meteo.com; frame-src 'self' https://js.stripe.com https://checkout.stripe.com; object-src 'none'; base-uri 'self';"

  # HTML-Dateien immer frisch validieren (verhindert Veralten im Browser-Cache)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# 6. Gzip / Brotli Kompression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# 7. Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>
